{
  "name": "@subframe7536/iconv-lite",
  "description": "Convert character encodings in pure javascript.",
  "version": "0.8.1",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "iconv",
    "convert",
    "charset",
    "icu"
  ],
  "author": "Alexander Shtuchkin <ashtuchkin@gmail.com>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./stream": {
      "require": "./dist/stream.cjs",
      "import": "./dist/stream.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "homepage": "https://github.com/subframe7536/iconv-lite",
  "bugs": "https://github.com/subframe7536/iconv-lite/issues",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/express"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/iconv-lite.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "engines": {
    "node": ">=12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "update": "node generation/gen-sbcs.js && node generation/gen-dbcs.js",
    "release": "pnpm run build && bumpp --all && npm publish"
  },
  "browser": {
    "stream": false
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "bumpp": "^10.2.3",
    "iconv": "^2.3.5",
    "tsdown": "^0.18.1"
  }
}
